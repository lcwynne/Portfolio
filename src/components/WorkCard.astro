---
import type { Work } from '../data/works';
interface Props { work: Work; }
const { work } = Astro.props;
const href = work.protected ? `/protected/${work.slug}` : `/work/${work.slug}`;
---

<a
  href={href}
  class="group block rounded-lg border border-[var(--color-line)] bg-white p-6 transition hover:border-[var(--color-ink)]"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-display text-2xl">{work.title}</h3>
    {work.protected && (
      <span
        class="rounded-full border border-[var(--color-line)] px-2 py-0.5 text-xs text-[var(--color-muted)]"
        aria-label="Password protected"
      >
        🔒 Protected
      </span>
    )}
  </div>
  <p class="mt-2 text-[var(--color-muted)]">{work.summary}</p>
  <ul class="mt-4 flex flex-wrap gap-2 text-xs uppercase tracking-wide text-[var(--color-muted)]">
    {work.tags.map((tag) => <li class="rounded bg-[var(--color-line)]/40 px-2 py-1">{tag}</li>)}
  </ul>
</a>
