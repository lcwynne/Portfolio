---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found — Lauren Wynne" description="Page not found.">
  <section class="mx-auto max-w-3xl px-5 py-32 text-center sm:px-8">
    <h1>404</h1>
    <p class="mt-4 text-[var(--color-muted)]">That page doesn't exist (yet).</p>
    <p class="mt-8">
      <a href="/" class="underline underline-offset-4">Back home</a>
    </p>
  </section>
</Layout>
